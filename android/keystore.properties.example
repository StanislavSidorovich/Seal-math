## Copy this file to keystore.properties in this same folder (android/) and
## fill in your real values. keystore.properties is gitignored — never
## commit it or the .jks file it points to.
##
## Generate the keystore first (run this yourself, from inside this android/
## folder, in your own terminal — not pasted into any chat/session — so the
## passwords never end up in a log anywhere):
##
##   cd android
##   keytool -genkeypair -v -keystore arctic-math-rescue-release.jks ^
##     -alias arctic-math-rescue -keyalg RSA -keysize 2048 -validity 10000
##
## Then back the .jks file up in two places (e.g. a password manager's file
## storage + an encrypted USB drive). Losing it means you can never publish
## an update to this app under the same Play Store listing again.

storeFile=../arctic-math-rescue-release.jks
storePassword=CHANGE_ME
keyAlias=arctic-math-rescue
keyPassword=CHANGE_ME
